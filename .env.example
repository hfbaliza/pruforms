# ---- Agent sign-in (Google) ----
# REQUIRED for the /admin dashboard. Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials (Application type: Web
# application; add your deployed URL — and http://localhost:3000 for local
# dev — under "Authorized JavaScript origins"). This value is public and
# safe to expose to the browser.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign each agent's session token after they sign in with
# Google. REQUIRED in production — generate one with `openssl rand -hex 32`.
SESSION_JWT_SECRET=change-me-to-a-long-random-string

# ---- Supabase (required on Vercel / serverless) ----
# From Supabase → Project Settings → API.
# Use the SERVICE ROLE key (server-side only — never expose it to the browser).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: table names (default to "sessions" / "agents")
# SUPABASE_TABLE=sessions
# SUPABASE_AGENTS_TABLE=agents

# ---- Submission notifications (optional) ----
# Every submission emails the owning agent directly. Set ADMIN_EMAIL to also
# CC a shared company inbox on every submission, across all agents.
ADMIN_EMAIL=admin@example.com
# Public base URL of the deployment, used in the notification link.
PUBLIC_URL=https://your-app.vercel.app

# ---- Email sending (optional; needed for admin "Send by email") ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM="Pru Forms <forms@example.com>"

# ---- Local only ----
# PORT=3000
# If SUPABASE_URL is not set, the app uses local file storage under data/.
